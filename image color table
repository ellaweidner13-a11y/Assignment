<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title> Fresh Strawberry Color Scheme </title>
    <style>
        <table>
            font-family: Arial, sans-serif;
        </table>
   </style>
</head>

<table>
    <caption>Strawberry Delight Color Scheme</caption>
    <thead>
        <tr>
            <th>Color Name</th>
            <th>Color Swatch</th>
            <th>HEX Value</th>
            <th>RGB Value</th>
            <th>HSL Value</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Strawberry Red</td>
            <td style="background-color: #D7263D;">Red</td>
            <td>#D7263D</td>
            <td>rgb(215, 38, 61)</td>
            <td>hsl(352, 70%, 50%)</td>
        </tr>
        <tr>
            <td>Strawberry Pink</td>
            <td style="background-color: #F6A5B7;">Pink</td>
            <td>#F6A5B7</td>
            <td>rgb(246, 165, 183)</td>
            <td>hsl(347, 82%, 81%)</td>
        </tr>
        <tr>
            <td>Leaf Green</td>
            <td style="background-color: #4F772D;">Green</td>
            <td>#4F772D</td>
            <td>rgb(79, 119, 45)</td>
            <td>hsl(92, 45%, 32%)</td>
        </tr>
        <tr>
            <td>Strawberry Cream</td>
            <td style="background-color: #FFF1E6;">Cream</td>
            <td>#FFF1E6</td>
            <td>rgb(255, 241, 230)</td>
            <td>hsl(26, 100%, 95%)</td>
        </tr>
    </tbody>
</table>

</body>
</html>
