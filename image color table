<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Fresh Strawberry Color Scheme</title>
    <style>
        table {
            width: 100%;
            border: 1xp solid black;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        caption {
            font-size: 24px;
            font-weight: bold;
            font-style: italic;
        }

        th, td {
            border: 1px solid black;
            padding: 12px;
        }

        Red {
            background-color: #D7263D;
            color: white;
        }

        Pink {
            background-color: #F6A5B7;
            color: black;
        }

        Green {
            background-color: #4F772D;
            color: white;
        }

        Cream {
            background-color: #FFF1E6;
            color: black;
        }
    </style>
</head>
<body>

<table>
    <caption>Fresh Strawberry Color Scheme</caption>
    <thead>
        <tr>
            <th class="red">Red</th>
            <th class="pink">Pink</th>
            <th class="green">Green</th>
            <th class="cream">Cream</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>#D7263D</td>
            <td>#F6A5B7</td>
            <td>#4F772D</td>
            <td>#FFF1E6</td>
        </tr>
        <tr>
            <td>rgb(215, 38, 61)</td>
            <td>rgb(246, 165, 183)</td>
            <td>rgb(79, 119, 45)</td>
            <td>rgb(255, 241, 230)</td>
        </tr>
        <tr>
            <td>hsl(352, 70%, 50%)</td>
            <td>hsl(347, 82%, 81%)</td>
            <td>hsl(92, 45%, 32%)</td>
            <td>hsl(26, 100%, 95%)</td>
        </tr>
    </tbody>
</table>
</body>
</html>
