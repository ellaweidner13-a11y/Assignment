
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Breakfast, Lunch, and Dinner Menus</title>

    <style>
        body {
            background-color: #f5f0e8;
            font-family: Georgia, serif;
            margin: 0;
            padding: 25px;
        }

        h1{
            text-align: center;
            color: #493528;
        }

        .menu-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .menu{
            width: 400px;
            height: 550px;
            box-sizing: border-box;
            padding: 25px;
            margin: 10px;
            border: 4px solid #c5a16b;
            border-radius: 15px;
            color: white;
            text-align: center;
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            text-shadow: 1px 1px 4px black;
        }

        .breakfast{
            background-image:
                linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.65)),
                url("https://wallpapers.com/images/file/breakfast-pictures-lpfxquhdxmu6g62k.jpg");
        }

        .lunch{
            background-image:
                linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.65)),
                url("https://wallpapers.com/images/featured/lunch-nma33l5qphyng7rh.jpg");
        }

        .dinner{
            background-image:
                linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.65)),
                url("https://static.vecteezy.com/system/resources/thumbnails/043/166/346/small_2x/ai-generated-a-cozy-winter-dinner-table-with-comfort-food-generative-ai-photo.jpeg");
        }

        .menu h2{
            font-size: 30px;
            text-transform: uppercase;
            letter-spacing: 3px;
            border-bottom: 2px solid #f5d69b;
            padding-bottom: 12px;
            margin-top: 5px;
        }

        .menu h3{
            color: #ffdda0;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .subtitle{
            font-style: italic;
            margin-bottom: 20px;
        }

        .item{
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            text-align: left;
            margin: 12px 0;
            padding-bottom: 8px;
            border-bottom: 1px dotted white;
        }

        .description{
            font-size: 12px;
            margin-top: 4px;
        }

        .price{
            font-weight: bold;
            white-space: nowrap;
        }

        .footer{
            margin-top: 22px;
            padding-top: 10px;
            border-top: 2px solid #f5d69b;
            font-style: italic;
        }
    </style>
</head>

<body>

    <h1>Our Restaurant Menus</h1>

    <div class="menu-container">

        <!-- BREAKFAST MENU -->
        <div class="menu breakfast">
            <h2>Breakfast</h2>
            <p class="subtitle">A delicious start to your day!</p>

            <h3>Food</h3>

            <div class="item">
                <div>
                    <strong>Pancakes</strong>
                    <div class="description">Fluffy pancakes with maple syrup</div>
                </div>
                <span class="price">$8</span>
            </div>

            <div class="item">
                <div>
                    <strong>Avocado Toast</strong>
                    <div class="description">Toasted bread with fresh avocado</div>
                </div>
                <span class="price">$7</span>
            </div>

            <div class="item">
                <div>
                    <strong>Cheese Omelet</strong>
                    <div class="description">Eggs, melted cheese, and herbs</div>
                </div>
                <span class="price">$10</span>
            </div>

            <h3>Drinks</h3>

            <div class="item">
                <span>Orange Juice</span>
                <span class="price">$4</span>
            </div>

            <div class="item">
                <span>Coffee</span>
                <span class="price">$3</span>
            </div>

            <div class="item">
                <span>Hot Chocolate</span>
                <span class="price">$4</span>
            </div>

            <p class="footer">Rise and shine!</p>
        </div>


        <!-- LUNCH MENU -->
        <div class="menu lunch">
            <h2>Lunch</h2>
            <p class="subtitle">Fresh flavors for your afternoon!</p>

            <h3>Food</h3>

            <div class="item">
                <div>
                    <strong>Cheeseburger</strong>
                    <div class="description">Beef, cheddar, lettuce, and tomato</div>
                </div>
                <span class="price">$12</span>
            </div>

            <div class="item">
                <div>
                    <strong>Grilled Chicken Sandwich</strong>
                    <div class="description">Chicken, lettuce, and house sauce</div>
                </div>
                <span class="price">$11</span>
            </div>

            <div class="item">
                <div>
                    <strong>Garden Salad</strong>
                    <div class="description">Fresh greens, cucumber, and tomatoes</div>
                </div>
                <span class="price">$9</span>
            </div>

            <h3>Drinks</h3>

            <div class="item">
                <span>Fresh Lemonade</span>
                <span class="price">$4</span>
            </div>

            <div class="item">
                <span>Iced Tea</span>
                <span class="price">$3</span>
            </div>

            <div class="item">
                <span>Strawberry Smoothie</span>
                <span class="price">$5</span>
            </div>

            <p class="footer">Enjoy every bite!</p>
        </div>


        <!-- DINNER MENU -->
        <div class="menu dinner">
            <h2>Dinner</h2>
            <p class="subtitle">Relax and enjoy a wonderful meal!</p>

            <h3>Food</h3>

            <div class="item">
                <div>
                    <strong>Grilled Salmon</strong>
                    <div class="description">Salmon with lemon and roasted vegetables</div>
                </div>
                <span class="price">$21</span>
            </div>

            <div class="item">
                <div>
                    <strong>Fettuccine Alfredo</strong>
                    <div class="description">Creamy Parmesan pasta</div>
                </div>
                <span class="price">$16</span>
            </div>

            <div class="item">
                <div>
                    <strong>Roasted Chicken</strong>
                    <div class="description">Herb chicken with garlic potatoes</div>
                </div>
                <span class="price">$19</span>
            </div>

            <h3>Drinks</h3>

            <div class="item">
                <span>Sparkling Water</span>
                <span class="price">$3</span>
            </div>

            <div class="item">
                <span>Berry Mocktail</span>
                <span class="price">$6</span>
            </div>

            <div class="item">
                <span>Apple Cider</span>
                <span class="price">$4</span>
            </div>

            <p class="footer">Good food, great memories!</p>
        </div>

    </div>

</body>
</html>
